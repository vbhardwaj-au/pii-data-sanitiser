        // Pre-registration functions
        function preRegisterAgent() {
            console.log('=== Pre-Register Agent button clicked ===');
            
            const form = document.getElementById('preRegisterForm');
            console.log('Form element:', form);
            
            if (!form.checkValidity()) {
                console.log('Form validation failed');
                form.reportValidity();
                return;
            }
            
            console.log('Form validation passed, preparing data...');

            const data = {
                name: document.getElementById('agentName').value,
                hostName: document.getElementById('hostName').value,
                location: document.getElementById('location').value,
                environment: document.getElementById('environment').value,
                cpuCores: parseInt(document.getElementById('cpuCores').value),
                memoryMB: parseInt(document.getElementById('memoryMB').value),
                maxConcurrentJobs: parseInt(document.getElementById('maxConcurrentJobs').value),
                port: 8080,
                version: "1.0.0",
                capabilities: {
                    canProcessSqlServer: document.getElementById('canProcessSqlServer').checked,
                    canProcessMySQL: document.getElementById('canProcessMySQL').checked,
                    canProcessPostgreSQL: document.getElementById('canProcessPostgreSQL').checked,
                    canProcessOracle: false,
                    maxDatabaseSizeGB: 100,
                    maxRowsPerBatch: 10000
                }
            };
            
            console.log('Request data prepared:', JSON.stringify(data, null, 2));

            // Disable button and show loading
            const btn = document.getElementById('preRegisterBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Registering...';
            console.log('Button disabled, showing loading state');
            
            const apiUrl = 'http://localhost:7001/api/agent/pre-register';
            const headers = {
                'Content-Type': 'application/json',
                'X-API-Key': 'portal-admin-key-2024'
            };
            
            console.log('Making API request to:', apiUrl);
            console.log('Request headers:', headers);
            console.log('Request body:', JSON.stringify(data));

            fetch(apiUrl, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(data)
            })
            .then(response => {
                console.log('Response received:', response);
                console.log('Response status:', response.status);
                console.log('Response statusText:', response.statusText);
                console.log('Response ok:', response.ok);
                
                if (!response.ok) {
                    console.error('Response not OK. Status:', response.status);
                    // Try to get error text
                    return response.text().then(text => {
                        console.error('Response text:', text);
                        throw new Error(`HTTP ${response.status}: ${text || response.statusText}`);
                    });
                }
                
                return response.json();
            })
            .then(result => {
                console.log('Parsed JSON result:', result);
                
                if (result.success) {
                    console.log('Registration successful');
                    console.log('Agent ID:', result.agentId);
                    console.log('API Key:', result.apiKey);
                    
                    // Show registration results
                    document.getElementById('resultAgentId').value = result.agentId;
                    document.getElementById('resultApiKey').value = result.apiKey;
                    
                    // Generate deployment commands with API key
                    generateDeploymentCommands(result.agentId, data.name, result.apiKey);
                    
                    // Show result section
                    document.getElementById('registrationResult').style.display = 'block';
                    
                    // Hide form
                    form.style.display = 'none';
                    btn.style.display = 'none';
                } else {
                    console.error('Registration failed with success=false:', result);
                    alert('Registration failed: ' + (result.errorMessage || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('=== Fetch error caught ===');
                console.error('Error type:', error.constructor.name);
                console.error('Error message:', error.message);
                console.error('Error stack:', error.stack);
                console.error('Full error object:', error);
                alert('Failed to pre-register agent: ' + error.message);
            })
            .finally(() => {
                console.log('Finally block - resetting button state');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-plus-circle"></i> Pre-Register Agent';
            });
        }

