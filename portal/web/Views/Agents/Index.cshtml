@model List<Contracts.Models.ObfuscationAgent>
@{
    ViewData["Title"] = "Distributed Agents";
}

<div class="container-fluid">
    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Agents</h6>
                            <h3 class="mb-0">@ViewBag.TotalAgents</h3>
                        </div>
                        <i class="bi bi-hdd-stack fs-1 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Online</h6>
                            <h3 class="mb-0 text-success">@ViewBag.OnlineAgents</h3>
                        </div>
                        <i class="bi bi-check-circle fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Busy</h6>
                            <h3 class="mb-0 text-warning">@ViewBag.BusyAgents</h3>
                        </div>
                        <i class="bi bi-activity fs-1 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Offline</h6>
                            <h3 class="mb-0 text-danger">@ViewBag.OfflineAgents</h3>
                        </div>
                        <i class="bi bi-x-circle fs-1 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Distributed Obfuscation Agents</h2>
        <div>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#preRegisterModal">
                <i class="bi bi-plus-circle"></i> Pre-Register Agent
            </button>
            <a href="@Url.Action("ProductAssignments", "Agents")" class="btn btn-warning">
                <i class="bi bi-diagram-3"></i> Product Assignments
            </a>
            <a href="@Url.Action("Health", "Agents")" class="btn btn-outline-info">
                <i class="bi bi-heart-pulse"></i> Health Status
            </a>
            <button class="btn btn-primary" onclick="refreshAgents()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Agents Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Name</th>
                            <th>Host</th>
                            <th>Location</th>
                            <th>Environment</th>
                            <th>Jobs</th>
                            <th>CPU</th>
                            <th>Memory</th>
                            <th>Last Heartbeat</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model)
                        {
                            <tr>
                                <td>
                                    @switch (agent.Status)
                                    {
                                        case Contracts.Models.AgentStatus.Online:
                                            <span class="badge bg-success">Online</span>
                                            break;
                                        case Contracts.Models.AgentStatus.Busy:
                                            <span class="badge bg-warning">Busy</span>
                                            break;
                                        case Contracts.Models.AgentStatus.Offline:
                                            <span class="badge bg-danger">Offline</span>
                                            break;
                                        case Contracts.Models.AgentStatus.Error:
                                            <span class="badge bg-danger">Error</span>
                                            break;
                                        case Contracts.Models.AgentStatus.Maintenance:
                                            <span class="badge bg-secondary">Maintenance</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Unknown</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <strong>@agent.Name</strong><br>
                                    <small class="text-muted">v@agent.Version</small>
                                </td>
                                <td>
                                    @agent.HostName<br>
                                    <small class="text-muted">@agent.IpAddress</small>
                                </td>
                                <td>@agent.Location</td>
                                <td>@agent.Environment</td>
                                <td>
                                    <div class="small">
                                        <span class="text-primary">Active: @agent.ActiveJobs</span><br>
                                        <span class="text-success">Done: @agent.CompletedJobs</span><br>
                                        <span class="text-danger">Failed: @agent.FailedJobs</span>
                                    </div>
                                </td>
                                <td>
                                    @if (agent.CurrentCpuUsage > 0)
                                    {
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(agent.CurrentCpuUsage > 80 ? "bg-danger" : agent.CurrentCpuUsage > 50 ? "bg-warning" : "bg-success")" 
                                                 style="width: @agent.CurrentCpuUsage%">
                                                @agent.CurrentCpuUsage.ToString("F1")%
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (agent.CurrentMemoryUsage > 0)
                                    {
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(agent.CurrentMemoryUsage > 80 ? "bg-danger" : agent.CurrentMemoryUsage > 50 ? "bg-warning" : "bg-info")" 
                                                 style="width: @agent.CurrentMemoryUsage%">
                                                @agent.CurrentMemoryUsage.ToString("F1")%
                                            </div>
                                        </div>
                                        <small>@agent.MemoryMB MB</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (agent.LastHeartbeat != default(DateTime))
                                    {
                                        var timeSince = DateTime.UtcNow - agent.LastHeartbeat;
                                        if (timeSince.TotalMinutes < 1)
                                        {
                                            <span class="text-success">Just now</span>
                                        }
                                        else if (timeSince.TotalMinutes < 60)
                                        {
                                            <span class="text-warning">@((int)timeSince.TotalMinutes) min ago</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@((int)timeSince.TotalHours) hours ago</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = agent.Id })" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-info" onclick="showDeploymentCommands('@agent.Id', '@agent.Name', '@agent.ApiKey')" title="Deployment Commands">
                                        <i class="bi bi-terminal"></i>
                                    </button>
                                    @if (agent.Status == Contracts.Models.AgentStatus.Offline)
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="updateStatus('@agent.Id', 'Online')" title="Start Agent">
                                            <i class="bi bi-play"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-warning" onclick="updateStatus('@agent.Id', 'Maintenance')" title="Pause Agent">
                                            <i class="bi bi-pause"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1"></i><br>
                                    No agents registered yet
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Pre-Register Agent Modal -->
<div class="modal fade" id="preRegisterModal" tabindex="-1" aria-labelledby="preRegisterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="preRegisterModalLabel">Pre-Register Agent for Deployment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="preRegisterForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="agentName" class="form-label">Agent Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="agentName" name="name" required>
                                <small class="text-muted">Unique identifier for this agent</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="hostName" class="form-label">Hostname <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="hostName" name="hostName" required>
                                <small class="text-muted">Hostname or container name</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="location" class="form-label">Location <span class="text-danger">*</span></label>
                                <select class="form-select" id="location" name="location" required>
                                    <option value="">Select Location</option>
                                    <option value="OnPremises">On-Premises</option>
                                    <option value="Docker">Docker</option>
                                    <option value="Kubernetes">Kubernetes</option>
                                    <option value="Azure-EastUS">Azure - East US</option>
                                    <option value="Azure-WestUS">Azure - West US</option>
                                    <option value="Azure-EastUS2">Azure - East US 2</option>
                                    <option value="Azure-CentralUS">Azure - Central US</option>
                                    <option value="AWS-US-East-1">AWS - US East 1</option>
                                    <option value="AWS-US-West-2">AWS - US West 2</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="environment" class="form-label">Environment</label>
                                <select class="form-select" id="environment" name="environment">
                                    <option value="Production">Production</option>
                                    <option value="Development">Development</option>
                                    <option value="Staging">Staging</option>
                                    <option value="Test">Test</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="cpuCores" class="form-label">CPU Cores</label>
                                <input type="number" class="form-control" id="cpuCores" name="cpuCores" value="2" min="1" max="16">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="memoryMB" class="form-label">Memory (MB)</label>
                                <input type="number" class="form-control" id="memoryMB" name="memoryMB" value="2048" min="512" max="32768">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="maxConcurrentJobs" class="form-label">Max Concurrent Jobs</label>
                                <input type="number" class="form-control" id="maxConcurrentJobs" name="maxConcurrentJobs" value="2" min="1" max="10">
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Capabilities</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="canProcessSqlServer" checked>
                            <label class="form-check-label" for="canProcessSqlServer">
                                SQL Server
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="canProcessMySQL">
                            <label class="form-check-label" for="canProcessMySQL">
                                MySQL
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="canProcessPostgreSQL">
                            <label class="form-check-label" for="canProcessPostgreSQL">
                                PostgreSQL
                            </label>
                        </div>
                    </div>
                </form>
                
                <div id="registrationResult" style="display: none;">
                    <hr>
                    <div class="alert alert-success">
                        <h6>Agent Pre-Registered Successfully!</h6>
                        <p>Use the following information to deploy your agent:</p>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Agent ID:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="resultAgentId" readonly>
                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('resultAgentId')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">API Key:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="resultApiKey" readonly>
                                <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('resultApiKey')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-3">
                        <label class="form-label">Deployment Options:</label>
                        <ul class="nav nav-tabs" id="deploymentTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="docker-tab" data-bs-toggle="tab" data-bs-target="#docker" type="button">Docker</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="kubernetes-tab" data-bs-toggle="tab" data-bs-target="#kubernetes" type="button">Kubernetes</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="azure-tab" data-bs-toggle="tab" data-bs-target="#azure" type="button">Azure App Service</button>
                            </li>
                        </ul>
                        <div class="tab-content mt-2" id="deploymentTabsContent">
                            <div class="tab-pane fade show active" id="docker" role="tabpanel">
                                <pre class="bg-dark text-light p-2"><code id="dockerCommand"></code></pre>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('dockerCommand')">
                                    <i class="bi bi-clipboard"></i> Copy Command
                                </button>
                            </div>
                            <div class="tab-pane fade" id="kubernetes" role="tabpanel">
                                <pre class="bg-dark text-light p-2"><code id="kubernetesYaml"></code></pre>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('kubernetesYaml')">
                                    <i class="bi bi-clipboard"></i> Copy YAML
                                </button>
                            </div>
                            <div class="tab-pane fade" id="azure" role="tabpanel">
                                <pre class="bg-dark text-light p-2"><code id="azureCommand"></code></pre>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('azureCommand')">
                                    <i class="bi bi-clipboard"></i> Copy Commands
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="preRegisterBtn" onclick="preRegisterAgent()">
                    <i class="bi bi-plus-circle"></i> Pre-Register Agent
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Deployment Commands Modal for Existing Agents -->
<div class="modal fade" id="deploymentCommandsModal" tabindex="-1" aria-labelledby="deploymentCommandsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deploymentCommandsModalLabel">
                    <i class="bi bi-terminal"></i> Deployment Commands - <span id="deploymentAgentName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Use these commands to deploy the agent in different environments.
                    The Agent ID is already configured in the commands below.
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Agent ID:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="deployAgentId" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('deployAgentId')">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Portal URL:</label>
                        <input type="text" class="form-control" value="http://localhost:7001" readonly>
                    </div>
                </div>
                
                <div class="mt-3">
                    <ul class="nav nav-tabs" id="deployTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="deploy-docker-tab" data-bs-toggle="tab" data-bs-target="#deploy-docker" type="button">
                                <i class="bi bi-box"></i> Docker
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="deploy-k8s-tab" data-bs-toggle="tab" data-bs-target="#deploy-k8s" type="button">
                                <i class="bi bi-grid-3x3"></i> Kubernetes
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="deploy-azure-tab" data-bs-toggle="tab" data-bs-target="#deploy-azure" type="button">
                                <i class="bi bi-cloud"></i> Azure
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="deploy-compose-tab" data-bs-toggle="tab" data-bs-target="#deploy-compose" type="button">
                                <i class="bi bi-layers"></i> Docker Compose
                            </button>
                        </li>
                    </ul>
                    
                    <div class="tab-content mt-3" id="deployTabsContent">
                        <div class="tab-pane fade show active" id="deploy-docker" role="tabpanel">
                            <h6>Docker Run Command:</h6>
                            <pre class="bg-dark text-light p-3 rounded"><code id="deployDockerCommand"></code></pre>
                            <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('deployDockerCommand')">
                                <i class="bi bi-clipboard"></i> Copy Command
                            </button>
                        </div>
                        
                        <div class="tab-pane fade" id="deploy-k8s" role="tabpanel">
                            <h6>Kubernetes Deployment YAML:</h6>
                            <pre class="bg-dark text-light p-3 rounded" style="max-height: 400px; overflow-y: auto;"><code id="deployK8sYaml"></code></pre>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('deployK8sYaml')">
                                    <i class="bi bi-clipboard"></i> Copy YAML
                                </button>
                                <button class="btn btn-sm btn-outline-primary" onclick="downloadYaml('deployK8sYaml', 'agent-deployment.yaml')">
                                    <i class="bi bi-download"></i> Download YAML
                                </button>
                            </div>
                        </div>
                        
                        <div class="tab-pane fade" id="deploy-azure" role="tabpanel">
                            <h6>Azure Container Instance Commands:</h6>
                            <pre class="bg-dark text-light p-3 rounded"><code id="deployAzureCommand"></code></pre>
                            <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('deployAzureCommand')">
                                <i class="bi bi-clipboard"></i> Copy Commands
                            </button>
                            <div class="mt-3">
                                <h6>Azure App Service (Web App for Containers):</h6>
                                <pre class="bg-dark text-light p-3 rounded"><code id="deployAzureAppService"></code></pre>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('deployAzureAppService')">
                                    <i class="bi bi-clipboard"></i> Copy Commands
                                </button>
                            </div>
                        </div>
                        
                        <div class="tab-pane fade" id="deploy-compose" role="tabpanel">
                            <h6>Docker Compose YAML:</h6>
                            <pre class="bg-dark text-light p-3 rounded" style="max-height: 400px; overflow-y: auto;"><code id="deployComposeYaml"></code></pre>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyCommand('deployComposeYaml')">
                                    <i class="bi bi-clipboard"></i> Copy YAML
                                </button>
                                <button class="btn btn-sm btn-outline-primary" onclick="downloadYaml('deployComposeYaml', 'docker-compose.yaml')">
                                    <i class="bi bi-download"></i> Download YAML
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="deploymentWarning" class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle"></i> <strong>Important:</strong> 
                    <ul class="mb-0" id="deploymentWarningList">
                        <li>Update <code>/path/to/portal</code> to your actual portal directory path</li>
                        <li>Ensure the Docker image is built from the portal directory (NOT agent-client) so it can access the contracts folder</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.js"></script>
    <script>
        let connection;
        
        function refreshAgents() {
            location.reload();
        }

        function updateStatus(agentId, status) {
            if (confirm('Are you sure you want to change the agent status?')) {
                fetch('@Url.Action("UpdateStatus", "Agents")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${agentId}&status=${status}`
                }).then(() => {
                    location.reload();
                });
            }
        }

        function initializeSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("http://localhost:7001/hubs/monitoring")
                .build();

            connection.start().then(function () {
                console.log("SignalR Connected");
                
                // Join monitoring groups
                connection.invoke("JoinAgentMonitoring");
                connection.invoke("JoinJobMonitoring");
                
            }).catch(function (err) {
                console.error("SignalR Connection Error: ", err.toString());
                // Fallback to auto-refresh if SignalR fails
                setInterval(refreshAgents, 30000);
            });

            // Handle agent status updates
            connection.on("AgentStatusUpdate", function (agentData) {
                console.log("Agent update received: ", agentData);
                updateAgentInUI(agentData);
            });

            // Handle system metrics updates
            connection.on("SystemMetricsUpdate", function (metrics) {
                console.log("System metrics update: ", metrics);
                updateSystemMetrics(metrics);
            });

            // Handle job status updates
            connection.on("JobStatusUpdate", function (jobData) {
                console.log("Job update received: ", jobData);
                // Update job counters in agent cards
                updateJobCountsInAgentUI(jobData);
            });

            // Handle system alerts
            connection.on("SystemAlert", function (alert) {
                console.log("System alert: ", alert);
                showAlert(alert);
            });
        }

        function updateAgentInUI(agentData) {
            // Find the agent row in the table
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                const cells = row.getElementsByTagName('td');
                if (cells.length > 1) {
                    const nameCell = cells[1];
                    const strongElement = nameCell.querySelector('strong');
                    if (strongElement && strongElement.textContent === agentData.Name) {
                        // Update status badge
                        const statusCell = cells[0];
                        statusCell.innerHTML = getStatusBadgeHTML(agentData.Status);
                        
                        // Update CPU usage
                        const cpuCell = cells[6];
                        if (agentData.CpuUsage !== null) {
                            cpuCell.innerHTML = getCpuProgressBarHTML(agentData.CpuUsage);
                        }
                        
                        // Update Memory usage
                        const memoryCell = cells[7];
                        if (agentData.MemoryUsage !== null) {
                            memoryCell.innerHTML = getMemoryProgressBarHTML(agentData.MemoryUsage);
                        }
                        
                        // Update job counts
                        const jobsCell = cells[5];
                        jobsCell.innerHTML = `
                            <div class="small">
                                <span class="text-primary">Active: ${agentData.ActiveJobs}</span><br>
                                <span class="text-success">Done: ${agentData.CompletedJobs}</span><br>
                                <span class="text-danger">Failed: ${agentData.FailedJobs}</span>
                            </div>
                        `;
                        
                        // Update last heartbeat
                        const heartbeatCell = cells[8];
                        heartbeatCell.innerHTML = '<span class="text-success">Just now</span>';
                    }
                }
            });
        }

        function updateSystemMetrics(metrics) {
            // Update KPI cards
            const totalAgentsCard = document.querySelector('.card.border-primary .mb-0');
            if (totalAgentsCard) totalAgentsCard.textContent = metrics.TotalAgents;
            
            const onlineAgentsCard = document.querySelector('.card.border-success .mb-0');
            if (onlineAgentsCard) onlineAgentsCard.textContent = metrics.OnlineAgents;
            
            const busyAgentsCard = document.querySelector('.card.border-warning .mb-0');
            if (busyAgentsCard) busyAgentsCard.textContent = metrics.BusyAgents;
            
            const offlineAgentsCard = document.querySelector('.card.border-danger .mb-0');
            if (offlineAgentsCard) offlineAgentsCard.textContent = metrics.OfflineAgents;
        }

        function getStatusBadgeHTML(status) {
            switch (status) {
                case 'Online':
                    return '<span class="badge bg-success">Online</span>';
                case 'Busy':
                    return '<span class="badge bg-warning">Busy</span>';
                case 'Offline':
                    return '<span class="badge bg-danger">Offline</span>';
                case 'Error':
                    return '<span class="badge bg-danger">Error</span>';
                case 'Maintenance':
                    return '<span class="badge bg-secondary">Maintenance</span>';
                default:
                    return '<span class="badge bg-secondary">Unknown</span>';
            }
        }

        function getCpuProgressBarHTML(cpuUsage) {
            const colorClass = cpuUsage > 80 ? 'bg-danger' : cpuUsage > 50 ? 'bg-warning' : 'bg-success';
            return `
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar ${colorClass}" style="width: ${cpuUsage}%">
                        ${cpuUsage.toFixed(1)}%
                    </div>
                </div>
            `;
        }

        function getMemoryProgressBarHTML(memoryUsage) {
            const colorClass = memoryUsage > 80 ? 'bg-danger' : memoryUsage > 50 ? 'bg-warning' : 'bg-info';
            return `
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar ${colorClass}" style="width: ${memoryUsage}%">
                        ${memoryUsage.toFixed(1)}%
                    </div>
                </div>
            `;
        }

        function updateJobCountsInAgentUI(jobData) {
            // This would update job progress bars and counts when jobs change status
            // For now, just log the update
