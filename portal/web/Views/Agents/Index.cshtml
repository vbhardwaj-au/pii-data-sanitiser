        }

        function showAlert(alert) {
            // Create a toast notification for alerts
            const alertHTML = `
                <div class="alert alert-${alert.Severity.toLowerCase() === 'error' ? 'danger' : 
                             alert.Severity.toLowerCase() === 'warning' ? 'warning' : 'info'} alert-dismissible fade show" 
                     style="position: fixed; top: 80px; right: 20px; z-index: 1050; min-width: 300px;">
                    <strong>${alert.Type} Alert:</strong> ${alert.Message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', alertHTML);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                const alertElements = document.querySelectorAll('.alert[style*="position: fixed"]');
                alertElements.forEach(el => {
                    if (el.querySelector('.btn-close')) {
                        el.remove();
                    }
                });
            }, 5000);
        }

        // Initialize SignalR when page loads
        document.addEventListener('DOMContentLoaded', function() {
