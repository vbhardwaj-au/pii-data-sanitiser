<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PII Obfuscation Portal</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-shield-check"></i>
                PII Obfuscation Portal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-list-ul"></i>
                            Products
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="agentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-hdd-stack"></i>
                            Agents
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="agentsDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Agents")">
                                <i class="bi bi-list"></i> All Agents
                            </a></li>
                            <li><a class="dropdown-item" href="@Url.Action("ProductAssignments", "Agents")">
                                <i class="bi bi-diagram-3"></i> Product Assignments
                            </a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Pipeline")">
                            <i class="bi bi-speedometer2"></i>
                            Pipeline Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Monitor", "Pipeline")">
                            <i class="bi bi-tv"></i>
                            Monitor
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="pipelineDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-layers"></i>
                            Pipeline
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="pipelineDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("ExecutionHistory", "Pipeline")">
                                <i class="bi bi-clock-history"></i> Execution History
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="@Url.Action("Scripts", "Pipeline", new { productId = ViewBag.CurrentProductId ?? "" })">
                                <i class="bi bi-code-square"></i> Manage Scripts
                            </a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Configure", "Pipeline", new { productId = ViewBag.CurrentProductId ?? "" })">
                                <i class="bi bi-gear"></i> Configure Pipeline
                            </a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span class="navbar-text">
                            <i class="bi bi-person-circle"></i>
                            Admin
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <span class="text-muted">© 2024 PII Obfuscation Portal</span>
                </div>
                <div class="col-md-6 text-end">
                    <span class="text-muted">Version 1.0.0</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Scripts2", required: false)
</body>
</html>
