@model Contracts.DTOs.PipelineConfigurationOverviewDto
@{
    ViewData["Title"] = $"Pipeline Configuration - {Model?.Product?.Name}";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-diagram-3"></i> Pipeline Configuration
            <small class="text-muted">@Model?.Product?.Name</small>
        </h1>
        <div>
            <button class="btn btn-success" onclick="startPipeline()">
                <i class="bi bi-play-circle"></i> Start Pipeline
            </button>
            <a href="@Url.Action("Dashboard", "Pipeline")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
        </div>
    }

    <!-- Pipeline Overview -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Stages</h6>
                    <h3 class="card-title">@(Model?.Stages?.Count ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Enabled Stages</h6>
                    <h3 class="card-title text-success">@(Model?.Stages?.Count(s => s.IsEnabled) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Scripts</h6>
                    <h3 class="card-title">@(Model?.Stages?.Sum(s => s.Scripts?.Count ?? 0) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Est. Duration</h6>
                    <h3 class="card-title">@(Model?.Settings?.EstimatedDurationMinutes ?? 0) min</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Settings -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="bi bi-gear"></i> Pipeline Settings
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="continueOnFailure" 
                               @(Model?.Settings?.ContinueOnFailure == true ? "checked" : "")>
                        <label class="form-check-label" for="continueOnFailure">
                            Continue on Failure
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="parallelExecution" 
                               @(Model?.Settings?.ParallelExecutionEnabled == true ? "checked" : "")>
                        <label class="form-check-label" for="parallelExecution">
                            Enable Parallel Execution
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="maxRetries" class="form-label">Max Retries</label>
                    <input type="number" class="form-control" id="maxRetries" 
                           value="@(Model?.Settings?.MaxRetryCount ?? 3)" min="0" max="10">
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Stages -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="bi bi-layers"></i> Pipeline Stages
            </h5>
        </div>
        <div class="card-body">
            @if (Model?.Stages?.Any() == true)
            {
                <div class="accordion" id="stagesAccordion">
                    @foreach (var stage in Model.Stages.OrderBy(s => s.ExecutionOrder))
                    {
                        var stageId = $"stage_{stage.Stage.Id}";
                        var isFirst = stage == Model?.Stages?.OrderBy(s => s.ExecutionOrder).FirstOrDefault();
                        
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading_@stageId">
                                <button class="accordion-button @(!isFirst ? "collapsed" : "")" type="button" 
                                        data-bs-toggle="collapse" data-bs-target="#@stageId" 
                                        aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@stageId">
                                    <span class="badge bg-secondary me-2">@stage.ExecutionOrder</span>
                                    <strong>@stage.Stage.DisplayName</strong>
                                    <span class="ms-auto me-3">
                                        @if (stage.IsEnabled)
                                        {
                                            <span class="badge bg-success">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                        <span class="badge bg-info ms-2">@stage.Scripts.Count scripts</span>
                                    </span>
                                </button>
                            </h2>
                            <div id="@stageId" class="accordion-collapse collapse @(isFirst ? "show" : "")" 
                                 aria-labelledby="heading_@stageId" data-bs-parent="#stagesAccordion">
                                <div class="accordion-body">
                                    <p>@stage.Stage.Description</p>
                                    
                                    <!-- Stage Configuration -->
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input stage-enabled" type="checkbox" 
                                                       id="enabled_@stage.Stage.Id" data-stage-id="@stage.Stage.Id"
                                                       @(stage.IsEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="enabled_@stage.Stage.Id">
                                                    Enable Stage
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Timeout (minutes)</label>
                                            <input type="number" class="form-control stage-timeout" 
                                                   data-stage-id="@stage.Stage.Id"
                                                   value="@(stage.Configuration?.TimeoutMinutes ?? stage.Stage.DefaultTimeoutMinutes)" 
                                                   min="1" max="1440">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">On Failure</label>
                                            <select class="form-select stage-failure-action" data-stage-id="@stage.Stage.Id">
                                                <option value="Stop" selected="@(stage.Configuration?.OnFailureAction == "Stop")">Stop Pipeline</option>
                                                <option value="Skip" selected="@(stage.Configuration?.OnFailureAction == "Skip")">Skip Stage</option>
                                                <option value="Warn" selected="@(stage.Configuration?.OnFailureAction == "Warn")">Warn and Continue</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <!-- Scripts for this stage -->
                                    <h6 class="mt-4">
                                        <i class="bi bi-code-slash"></i> Scripts
                                        <button class="btn btn-sm btn-primary float-end" 
                                                onclick="addScript('@ViewBag.ProductId', '@stage.Stage.Id')">
                                            <i class="bi bi-plus"></i> Add Script
                                        </button>
                                    </h6>
                                    
                                    @if (stage.Scripts?.Any() == true)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr>
                                                        <th width="40">Order</th>
                                                        <th>Name</th>
                                                        <th>Description</th>
                                                        <th width="80">Enabled</th>
                                                        <th width="80">Validated</th>
                                                        <th width="150">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="scripts-list" data-stage-id="@stage.Stage.Id">
                                                    @foreach (var script in stage.Scripts.OrderBy(s => s.ExecutionOrder))
                                                    {
                                                        <tr data-script-id="@script.Id" data-order="@script.ExecutionOrder">
                                                            <td>
                                                                <span class="badge bg-secondary">@script.ExecutionOrder</span>
                                                            </td>
                                                            <td>@script.Name</td>
                                                            <td>
                                                                <small class="text-muted">@script.Description</small>
                                                            </td>
                                                            <td>
                                                                @if (script.IsEnabled)
                                                                {
                                                                    <i class="bi bi-check-circle text-success"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-x-circle text-danger"></i>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (script.IsSecurityValidated)
                                                                {
                                                                    <i class="bi bi-shield-check text-success"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-shield-x text-warning"></i>
                                                                }
                                                            </td>
                                                            <td>
                                                                <button class="btn btn-sm btn-outline-primary" 
                                                                        onclick="editScript('@ViewBag.ProductId', '@stage.Stage.Id', '@script.Id')">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger" 
                                                                        onclick="deleteScript('@script.Id')">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-secondary drag-handle" 
                                                                        title="Drag to reorder">
                                                                    <i class="bi bi-grip-vertical"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted text-center my-3">
                                            <i class="bi bi-inbox"></i> No scripts configured for this stage
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center my-5">
                    <i class="bi bi-inbox fs-1"></i><br/>
                    No pipeline stages configured
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        // Initialize drag-and-drop for script reordering
        document.querySelectorAll('.scripts-list').forEach(function(list) {
            new Sortable(list, {
                animation: 150,
                handle: '.drag-handle',
                onEnd: function(evt) {
                    // Update script order
                    updateScriptOrder(evt.item.dataset.scriptId, evt.newIndex + 1);
                }
            });
        });

        function startPipeline() {
            if (confirm('Are you sure you want to start the pipeline for this product?')) {
                fetch('/Pipeline/StartExecution', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: '@ViewBag.ProductId' })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Pipeline started successfully!');
                        window.location.href = '@Url.Action("Monitor", "Pipeline")' + '?executionId=' + data.executionId;
                    } else {
                        alert('Failed to start pipeline: ' + data.error);
                    }
                });
            }
        }

        function addScript(productId, stageId) {
            window.location.href = '@Url.Action("EditScript", "Pipeline")' + 
                '?productId=' + productId + '&stageId=' + stageId;
        }

        function editScript(productId, stageId, scriptId) {
            window.location.href = '@Url.Action("EditScript", "Pipeline")' + 
                '?productId=' + productId + '&stageId=' + stageId + '&scriptId=' + scriptId;
        }

        function deleteScript(scriptId) {
            if (confirm('Are you sure you want to delete this script?')) {
                // TODO: Implement delete script API call
                alert('Delete functionality to be implemented');
            }
        }

        function updateScriptOrder(scriptId, newOrder) {
            // TODO: Implement script order update API call
            console.log('Update script ' + scriptId + ' to order ' + newOrder);
        }

        // Handle stage configuration changes
        document.querySelectorAll('.stage-enabled, .stage-timeout, .stage-failure-action').forEach(function(input) {
            input.addEventListener('change', function() {
                // TODO: Implement stage configuration update API call
                console.log('Stage configuration changed');
            });
        });
    </script>
}