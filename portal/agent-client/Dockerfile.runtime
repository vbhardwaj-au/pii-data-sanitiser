# Runtime Dockerfile for pre-built agent
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# Install curl for health checks
RUN apt-get update && \
    apt-get install -y curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy published files from the publish directory
COPY publish/ ./

# Create required directories
RUN mkdir -p /app/config /app/data /app/logs

# Environment variables for configuration
ENV AGENT__NAME=DockerAgent
ENV AGENT__HOSTNAME=docker-agent
ENV AGENT__PORT=5001
ENV PORTAL__BASEURL=http://host.docker.internal:7001

# Expose port
EXPOSE 8080

# Run the agent
ENTRYPOINT ["dotnet", "ObfuscationAgent.dll"]